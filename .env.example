LOG_LEVEL=info
LOG_FORMAT=text

GRPC_ADDRESS=:50051
HTTP_ADDRESS=:8080

OPENSEARCH_ADDRESSES=http://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=
OPENSEARCH_API_KEY=
OPENSEARCH_INSECURE_SKIP_VERIFY=false

# Self-hosted Temporal. Set TEMPORAL_CLOUD=true and TEMPORAL_ACCOUNT for Cloud;
# endpoints then resolve to <namespace>.<account>.tmprl.cloud:7233.
TEMPORAL_NAMESPACES=default
TEMPORAL_CLOUD=false
TEMPORAL_ACCOUNT=
TEMPORAL_ENDPOINT=localhost:7233
TEMPORAL_BASE_URL=http://localhost:8080
TEMPORAL_API_KEY=
TEMPORAL_TLS=false
TEMPORAL_INSECURE_SKIP_VERIFY=false
TEMPORAL_SERVER_NAME=
TEMPORAL_CA_FILE=
TEMPORAL_CLIENT_CERT_FILE=
TEMPORAL_CLIENT_KEY_FILE=
TEMPORAL_BULK_ACTIONS_PER_SECOND=8
TEMPORAL_LIST_REQUESTS_PER_SECOND=8
TEMPORAL_HISTORY_REQUESTS_PER_SECOND=8
TEMPORAL_INDEX_PREFIX=workflows-
TEMPORAL_RETENTION_PERIOD=720h
TEMPORAL_RETENTION_CRON="0 0 * * *"
TEMPORAL_DATA_WORKERS=8
TEMPORAL_INDEX_WORKERS=4
TEMPORAL_INDEX_BATCH_SIZE=100
